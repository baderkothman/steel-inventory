{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steel Inventory",
  "version": "1.0.5",
  "identifier": "com.local.steel-inventory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Steel Inventory",
        "width": 1320,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2QzcyMUQ1MDA3OUIyOEQKUldTTnNua0ExU0hIOXRCdjI4K0dDM1JoNEFXZjlQVmhEYTdIMDJnYzRNUC9scEQwdnR0TklzSjAK",
      "endpoints": [
        "https://github.com/baderkothman/steel-inventory/releases/latest/download/latest.json"
      ]
    }
  }
}
